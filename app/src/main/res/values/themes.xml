<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.LarvIDE" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/text_on_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_secondary</item>
        <item name="popupMenuStyle">@style/Widget.LarvIDE.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.LarvIDE.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.LarvIDE.PopupMenu.ListPopupWindow</item>
        <item name="alertDialogTheme">@style/Theme.LarvIDE.Dialog.Alert</item>
        <item name="materialAlertDialogTheme">@style/Theme.LarvIDE.Dialog.Alert</item>
        <item name="android:statusBarColor">@color/status_bar_background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.LarvIDE.NoActionBar" parent="Theme.LarvIDE">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.LarvIDE.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="colorPrimary">@color/ide_accent</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="android:colorBackground">@color/dialog_background</item>
        <item name="colorSurface">@color/dialog_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.LarvIDE.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.LarvIDE.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.LarvIDE.DialogButton</item>
    </style>

    <style name="Theme.LarvIDE.Dialog.Alert" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/ide_accent</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="android:colorBackground">@color/dialog_background</item>
        <item name="colorSurface">@color/dialog_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.LarvIDE.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.LarvIDE.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.LarvIDE.DialogButton</item>
        <item name="listChoiceBackgroundIndicator">@drawable/popup_menu_background</item>
    </style>

    <style name="Widget.LarvIDE.DialogButton.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/ide_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/hover</item>
    </style>

    <style name="Widget.LarvIDE.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="rippleColor">@color/hover</item>
    </style>

    <style name="Widget.LarvIDE.PopupMenu" parent="Widget.MaterialComponents.PopupMenu.ContextMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.LarvIDE.PopupMenu.ListPopupWindow" parent="Widget.MaterialComponents.PopupMenu.ListPopupWindow">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Editor Tab Layout -->
    <style name="Widget.LarvIDE.EditorTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabSelectedTextColor">@color/tab_selected_text</item>
        <item name="tabTextColor">@color/tab_unselected_text</item>
        <item name="tabBackground">@drawable/editor_tab_background</item>
        <item name="tabTextAppearance">@style/TextAppearance.LarvIDE.EditorTab</item>
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">fill</item>
        <item name="tabMinWidth">80dp</item>
        <item name="tabMaxWidth">240dp</item>
    </style>

    <style name="TextAppearance.LarvIDE.EditorTab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontWeight">400</item>
    </style>

    <!-- Bottom Tab Layout -->
    <style name="Widget.LarvIDE.BottomTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabSelectedTextColor">@color/tab_selected_text</item>
        <item name="tabTextColor">@color/tab_unselected_text</item>
        <item name="tabBackground">@color/tab_bar_background</item>
        <item name="tabTextAppearance">@style/TextAppearance.LarvIDE.BottomTab</item>
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">fill</item>
        <item name="tabMinWidth">72dp</item>
        <item name="tabMaxWidth">160dp</item>
    </style>

    <style name="TextAppearance.LarvIDE.BottomTab" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
    </style>

    <!-- Tool Window Tab Layout (Vertical) -->
    <style name="Widget.LarvIDE.ToolWindowTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicator">@null</item>
        <item name="tabSelectedTextColor">@color/text_primary</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabBackground">@drawable/tool_window_tab_background</item>
        <item name="tabTextAppearance">@style/TextAppearance.LarvIDE.ToolWindowTab</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
    </style>

    <style name="TextAppearance.LarvIDE.ToolWindowTab" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
    </style>

    <!-- Toolbar Style -->
    <style name="Widget.LarvIDE.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/toolbar_background</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.LarvIDE.ToolbarButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">28dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="rippleColor">@color/hover</item>
    </style>

    <style name="Widget.LarvIDE.FabRun" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/success</item>
        <item name="tint">@color/text_on_primary</item>
        <item name="rippleColor">@color/primary_light</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.LarvIDE.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">4dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.LarvIDE.SidebarCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/sidebar_background</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Divider -->
    <style name="Widget.LarvIDE.Divider" parent="">
        <item name="android:background">@color/divider</item>
    </style>

    <!-- Menu Bar Item -->
    <style name="Widget.LarvIDE.MenuItem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>