<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- Menu Bar (File Edit Search View Build Settings) -->
    <LinearLayout
        android:id="@+id/menuBar"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/toolbar_background"
        android:paddingHorizontal="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/menuFile"
            style="@style/Widget.LarvIDE.MenuItem"
            android:text="File" />

        <TextView
            android:id="@+id/menuEdit"
            style="@style/Widget.LarvIDE.MenuItem"
            android:text="Edit" />

        <TextView
            android:id="@+id/menuSearch"
            style="@style/Widget.LarvIDE.MenuItem"
            android:text="Search" />

        <TextView
            android:id="@+id/menuView"
            style="@style/Widget.LarvIDE.MenuItem"
            android:text="View" />

        <TextView
            android:id="@+id/menuBuild"
            style="@style/Widget.LarvIDE.MenuItem"
            android:text="Build" />

        <TextView
            android:id="@+id/menuSettings"
            style="@style/Widget.LarvIDE.MenuItem"
            android:text="Settings" />
    </LinearLayout>

    <!-- Main Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/menuBar"
        app:layout_constraintBottom_toTopOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left Tool Window Content (Project, Structure, etc.) -->
        <FrameLayout
            android:id="@+id/leftToolWindowContent"
            android:layout_width="200dp"
            android:layout_height="0dp"
            android:background="@color/surface"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Project Tool Window -->
            <FrameLayout
                android:id="@+id/projectToolWindow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Project Toolbar -->
                    <LinearLayout
                        android:id="@+id/projectToolbar"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:background="@color/surface"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/project"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="16dp" />

                        <ImageButton
                            android:id="@+id/btnNewFile"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/new_file"
                            android:src="@drawable/ic_new_file"
                            android:tint="@color/text_secondary"
                            android:scaleType="centerInside" />

                        <ImageButton
                            android:id="@+id/btnNewFolder"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/new_folder"
                            android:src="@drawable/ic_new_folder"
                            android:tint="@color/text_secondary"
                            android:scaleType="centerInside" />

                        <ImageButton
                            android:id="@+id/btnRefreshProject"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Refresh"
                            android:src="@drawable/ic_refresh"
                            android:tint="@color/text_secondary"
                            android:scaleType="centerInside" />

                        <ImageButton
                            android:id="@+id/btnCollapseAll"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Collapse All"
                            android:src="@drawable/ic_collapse_all"
                            android:tint="@color/text_secondary"
                            android:scaleType="centerInside" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btnCloseProjectWindow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Close project panel"
                            android:src="@drawable/ic_close"
                            android:tint="@color/text_secondary"
                            android:scaleType="centerInside" />
                    </LinearLayout>

                    <!-- Project Tree -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/fileTreeRecyclerView"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        app:layout_constraintTop_toBottomOf="@id/projectToolbar"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- Left Resizer -->
        <View
            android:id="@+id/leftResizer"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:background="@color/resizer"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/leftToolWindowContent" />

        <!-- Editor Area -->
        <FrameLayout
            android:id="@+id/editorArea"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/island_background"
            android:padding="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomResizer"
            app:layout_constraintStart_toEndOf="@id/leftResizer"
            app:layout_constraintEnd_toStartOf="@id/rightResizer">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent">

                <!-- Editor Tab Bar -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:background="@color/tab_bar_background"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/editorTabActions"
                    app:tabIndicatorColor="@color/primary"
                    app:tabIndicatorHeight="2dp"
                    app:tabIndicatorFullWidth="false"
                    app:tabSelectedTextColor="@color/text_primary"
                    app:tabTextColor="@color/text_secondary"
                    app:tabRippleColor="@color/hover"
                    app:tabTextAppearance="@style/TextAppearance.LarvIDE.EditorTab"
                    app:tabMode="scrollable"
                    app:tabGravity="fill" />

                <!-- Editor Tab Actions -->
                <LinearLayout
                    android:id="@+id/editorTabActions"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingEnd="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageButton
                        android:id="@+id/btnRun"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_run_button"
                        android:contentDescription="@string/run_code"
                        android:src="@drawable/ic_run"
                        android:scaleType="centerInside" />

                    <ImageButton
                        android:id="@+id/btnSplitEditor"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Expand editor"
                        android:src="@drawable/ic_expand"
                        android:tint="@color/text_secondary"
                        android:scaleType="centerInside" />

                    <ImageButton
                        android:id="@+id/newTabButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/new_file"
                        android:src="@drawable/ic_add"
                        android:tint="@color/text_secondary"
                        android:scaleType="centerInside" />
                </LinearLayout>

                <!-- Editor Content -->
                <FrameLayout
                    android:id="@+id/editorContainer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/editor_background"
                    app:layout_constraintTop_toBottomOf="@id/tabLayout"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- No Editor Placeholder -->
                <TextView
                    android:id="@+id/noEditorPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No file open\nDouble-click a file in Project view"
                    android:textColor="@color/text_disabled"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Welcome / Start Screen -->
                <LinearLayout
                    android:id="@+id/welcomeView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_java"
                        android:contentDescription="@string/app_name" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Lightweight Java IDE"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWelcomeNewProject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="20dp"
                            android:text="@string/new_project"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWelcomeOpenProject"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:paddingHorizontal="20dp"
                            android:text="@string/open_project"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <!-- Right Resizer -->
        <View
            android:id="@+id/rightResizer"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:background="@color/resizer"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rightToolWindowContent" />

        <!-- Right Tool Window Content -->
        <FrameLayout
            android:id="@+id/rightToolWindowContent"
            android:layout_width="280dp"
            android:layout_height="0dp"
            android:background="@drawable/island_background"
            android:padding="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Structure / TODO / Database"
                android:textColor="@color/text_disabled"
                android:textSize="12sp" />
        </FrameLayout>

        <!-- Bottom Resizer -->
        <View
            android:id="@+id/bottomResizer"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/resizer"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/bottomToolWindow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Tool Window (Run, Debug, Terminal, Problems) -->
        <FrameLayout
            android:id="@+id/bottomToolWindow"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:background="@drawable/island_background"
            android:padding="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Bottom Tool Window Header -->
                <LinearLayout
                    android:id="@+id/bottomToolWindowHeader"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Bottom Tab Bar -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/bottomTabLayout"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/tab_bar_background"
                        app:tabIndicatorColor="@color/primary"
                        app:tabIndicatorHeight="2dp"
                        app:tabIndicatorFullWidth="false"
                        app:tabSelectedTextColor="@color/text_primary"
                        app:tabTextColor="@color/text_secondary"
                        app:tabRippleColor="@color/hover"
                        app:tabTextAppearance="@style/TextAppearance.LarvIDE.BottomTab"
                        app:tabMode="scrollable"
                        app:tabGravity="fill" />

                    <ImageButton
                        android:id="@+id/btnCloseBottomWindow"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Close panel"
                        android:src="@drawable/ic_close"
                        android:tint="@color/text_secondary"
                        android:scaleType="centerInside" />
                </LinearLayout>

                <!-- Bottom Content -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/bottomViewPager"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toBottomOf="@id/bottomToolWindowHeader"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Status Bar -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_status_bar"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/statusEncoding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UTF-8"
        android:textColor="@color/text_disabled"
        android:textSize="10sp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/statusLineEnding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LF"
        android:textColor="@color/text_disabled"
        android:textSize="10sp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/statusPosition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ln 1, Col 1"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>